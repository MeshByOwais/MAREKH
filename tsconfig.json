{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "tools/generate_routes.ts",
    "tools/generate_crew_routes.ts",
    "tools/generate_global_routes.ts",
    "tools/package_continuous_plan.ts"
  ]
}
